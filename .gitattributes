qa/prelive/clay-stars/canonical-live-2.3.2.html -whitespace

# Package provenance and the generated licence copy retain stable LF bytes.
vendor/dancerudiments/LICENSE text eol=lf
assets/vendor/dancerudiments/LICENSE text eol=lf

# Shared library declarations and public package licence are text, with stable builds.
*.d.ts text eol=lf
LICENSE text eol=lf

# Keep original DanceFlow artwork byte-identical across platform packages.
**/branding/*.svg text eol=lf
**/branding/*.png binary

# Original FrameRudiments atlases are pinned and must retain their exact bytes.
assets/visualiser-sprites/*.png binary

# Canonical cross-platform checkout policy. Git stores text as LF and checks it
# out as LF, so content hashes do not depend on core.autocrlf.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
